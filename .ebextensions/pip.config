commands:
  01_pip_config:
    command: |
      mkdir -p /home/ec2-user/.pip
      cat > /home/ec2-user/.pip/pip.conf << 'EOF'
      [global]
      no-cache-dir = true
      no-binary = :all:
      prefer-binary = true
      EOF
      chown -R ec2-user:ec2-user /home/ec2-user/.pip

container_commands:
  01_install_build_deps:
    command: |
      yum install -y python3-devel gcc gcc-c++ make zlib-devel libpng-devel freetype-devel libjpeg-turbo-devel openblas-devel lapack-devel blas-devel
    ignoreErrors: true

