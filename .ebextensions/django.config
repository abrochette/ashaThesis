option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: ashaThesis.wsgi:application
  aws:autoscaling:launchconfiguration:
    InstanceType: t3.small
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 7

commands:
  01_create_data_dir:
    command: "mkdir -p /var/app/data && chmod 777 /var/app/data"
  02_copy_gtf_file:
    command: "cp /var/app/current/media/gencode.vM25.annotation.gtf /var/app/data/ 2>/dev/null || true && chmod 644 /var/app/data/gencode.vM25.annotation.gtf 2>/dev/null || true"

container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  02_fix_db_permissions:
    command: "chmod 666 /var/app/data/db.sqlite3 2>/dev/null || true"
    ignoreErrors: true
